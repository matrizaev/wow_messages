#tag_all versions "3.3.5";

flag OtherFlag : u32 {
    FLYING = 0x00002000;
    CATMULLROM = 0x00040000;
}

struct WrongSplineDiscriminator {
    OtherFlag movement_flags;
    if (movement_flags & FLYING || movement_flags & CATMULLROM) {
        FullMonsterMoveSpline full_splines;
    } else {
        MonsterMoveSplines splines;
    }
}
